relational operators

#include <stdio.h>

void check_relationship(int a, int b) {
    printf("a == b : %d\n", a == b);
    printf("a != b : %d\n", a != b);
    printf("a > b  : %d\n", a > b);
    printf("a < b  : %d\n", a < b);
    printf("a >= b : %d\n", a >= b);
    printf("a <= b : %d\n", a <= b);
}

int main() {
    int x = 10;
    int y = 5;
    
    check_relationship(x, y);
    
    return 0;
}
 

Bitwise operator

#include <stdio.h>

int main() {
    unsigned int a = 60;
    unsigned int b = 13;
    int result;

    result = a & b;
    printf("%d\n", result);

    result = a | b;
    printf("%d\n", result);

    result = a ^ b;
    printf("%d\n", result);

    result = ~a;
    printf("%d\n", result);

    result = a << 2;
    printf("%d\n", result);

    result = a >> 2;
    printf("%d\n", result);

    return 0;
}
